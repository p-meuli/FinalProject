  m_Name: 
  m_EditorClassIdentifier: 
  info1: "WELCOME TO THE CRYSTAL WOODS! \n"
  info2: "This heritage site acts as a natural central bank and renewable reserve
    for the funkgus kingdom, \n"
  info3: "At the behest of his royal highness King Flint Funkgus. Here, money literally
    grows on trees! \n"
  info4: (and around them too!)
  info5: "Unauthorized possession of gems is a captial offense against the crown,
    and is enforced by goblin mercinaries. \n"
  info6: -- Jerome Sporewell
  forestText: {fileID: 893280566}
